      "inputScale": 0.8,
      "requiresMutation": true,
      "steps": [
        { "id": "launch", "type": "launch_editor", "level": 12 },
        { "id": "window", "type": "wait_for_window", "timeoutSeconds": 45 },
        { "id": "load", "type": "wait", "seconds": 12 },
        { "id": "healthy", "type": "assert_process" },
        { "id": "open-reset-pause", "type": "key", "key": "ESC" },
        { "id": "reset-prior-state", "type": "click", "x": 1188, "y": 922 },
        { "id": "reset-prior-settle", "type": "wait", "seconds": 8 },
        { "id": "close-reset-pause", "type": "key", "key": "ESC" },
        { "id": "select", "type": "click", "button": "right", "x": 900, "y": 400 },
        { "id": "select-settle", "type": "wait", "seconds": 1 },
