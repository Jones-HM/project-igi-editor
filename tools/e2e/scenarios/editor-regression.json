{
  "schemaVersion": 1,
  "scenarios": [
    {
      "name": "level9-weather-viewport",
      "level": 9,
      "requiresMutation": false,
      "steps": [
        { "id": "launch", "type": "launch_editor", "level": 9 },
        { "id": "window", "type": "wait_for_window", "timeoutSeconds": 45 },
        { "id": "load", "type": "wait", "seconds": 12 },
        { "id": "healthy", "type": "assert_process" },
        { "id": "scene", "type": "screenshot", "name": "level9-scene" },
        { "id": "scene-visible", "type": "assert_screenshot_region", "region": [300, 80, 900, 700], "minNonBlackRatio": 0.15, "minUniqueRatio": 0.01, "minMeanLuma": 20 },
        { "id": "close", "type": "close_editor" }
      ]
    },
    {
      "name": "level12-startup-glass-visibility",
      "level": 12,
      "requiresMutation": false,
      "steps": [
        { "id": "launch", "type": "launch_editor", "level": 12 },
        { "id": "window", "type": "wait_for_window", "timeoutSeconds": 45 },
        { "id": "load", "type": "wait", "seconds": 12 },
        { "id": "healthy", "type": "assert_process" },
        { "id": "authored-start", "type": "assert_log", "pattern": "Viewer start source=level-authored-start" },
        { "id": "scene", "type": "screenshot", "name": "level12-startup" },
        { "id": "scene-visible", "type": "assert_screenshot_region", "region": [300, 80, 900, 700], "minNonBlackRatio": 0.15, "minUniqueRatio": 0.01, "minMeanLuma": 20 },
        { "id": "close", "type": "close_editor" }
      ]
    },
    {
      "name": "pause-logging-and-severity",
      "level": 9,
      "inputScale": 0.8,
      "requiresMutation": true,
      "steps": [
        { "id": "launch", "type": "launch_editor", "level": 9 },
        { "id": "window", "type": "wait_for_window", "timeoutSeconds": 45 },
        { "id": "load", "type": "wait", "seconds": 12 },
        { "id": "healthy", "type": "assert_process" },
        { "id": "open-pause", "type": "key", "key": "ESC" },
        { "id": "pause-settle", "type": "wait", "seconds": 0.5 },
        { "id": "pause-before", "type": "screenshot", "name": "pause-before" },
        { "id": "logging-precondition", "type": "assert_file", "path": "editor/qed/qedconfig.qsc", "pattern": "QEDLogs\\(TRUE\\)", "timeoutSeconds": 2 },
        { "id": "logging-off", "type": "click", "x": 900, "y": 510 },
        { "id": "logging-off-settle", "type": "wait", "seconds": 0.3 },
        { "id": "logging-off-screen", "type": "screenshot", "name": "logging-off" },
        { "id": "logging-off-file", "type": "assert_file", "path": "editor/qed/qedconfig.qsc", "pattern": "QEDLogs\\(FALSE\\)" },
        { "id": "logging-on", "type": "click", "x": 900, "y": 510 },
        { "id": "severity-max-1", "type": "click", "x": 1060, "y": 548 },
        { "id": "severity-max-2", "type": "click", "x": 1060, "y": 548 },
        { "id": "severity-max-3", "type": "click", "x": 1060, "y": 548 },
        { "id": "severity-max-4", "type": "click", "x": 1060, "y": 548 },
        { "id": "severity-info-1", "type": "click", "x": 953, "y": 548 },
        { "id": "severity-info-2", "type": "click", "x": 953, "y": 548 },
        { "id": "severity-info-3", "type": "click", "x": 953, "y": 548 },
        { "id": "logging-on-file", "type": "assert_file", "path": "editor/qed/qedconfig.qsc", "pattern": "QEDLogs\\(TRUE\\)[\\s\\S]*QEDLogLevel\\(1\\)" },
        { "id": "logging-on-screen", "type": "screenshot", "name": "logging-on" },
        { "id": "close", "type": "close_editor", "force": true }
      ]
    },
    {
      "name": "level12-property-panel-selection",
      "level": 12,
      "inputScale": 0.8,
      "requiresMutation": false,
      "steps": [
        { "id": "launch", "type": "launch_editor", "level": 12 },
        { "id": "window", "type": "wait_for_window", "timeoutSeconds": 45 },
        { "id": "load", "type": "wait", "seconds": 12 },
        { "id": "healthy", "type": "assert_process" },
        { "id": "startup", "type": "screenshot", "name": "startup" },
        { "id": "open-properties", "type": "click", "button": "right", "x": 900, "y": 400 },
        { "id": "panel-settle", "type": "wait", "seconds": 1 },
        { "id": "properties", "type": "screenshot", "name": "properties" },
        { "id": "close", "type": "close_editor", "force": true }
      ]
    },
    {
      "name": "level12-transform-save-reopen",
      "level": 12,
      "inputScale": 0.8,
      "requiresMutation": true,
      "steps": [
        { "id": "launch", "type": "launch_editor", "level": 12 },
        { "id": "window", "type": "wait_for_window", "timeoutSeconds": 45 },
        { "id": "load", "type": "wait", "seconds": 12 },
        { "id": "healthy", "type": "assert_process" },
        { "id": "open-reset-before", "type": "key", "key": "ESC" },
        { "id": "reset-before", "type": "click", "x": 1188, "y": 922 },
        { "id": "reset-before-settle", "type": "wait", "seconds": 8 },
        { "id": "close-reset-pause", "type": "key", "key": "ESC" },
        { "id": "select", "type": "click", "button": "right", "x": 900, "y": 400 },
        { "id": "select-settle", "type": "wait", "seconds": 1 },
        { "id": "edit-x", "type": "click", "x": 125, "y": 120 },
        { "id": "select-x", "type": "key", "key": "CTRL+A" },
        { "id": "new-x", "type": "type_text", "text": "112255472.0" },
        { "id": "commit-x", "type": "key", "key": "ENTER" },
        { "id": "edited", "type": "screenshot", "name": "edited-transform" },
        { "id": "close-properties-before-save", "type": "key", "key": "ESC" },
        { "id": "save", "type": "key", "key": "CTRL+W" },
        { "id": "save-settle", "type": "wait", "seconds": 3 },
        { "id": "save-log", "type": "assert_log", "pattern": "QVM round-trip validation passed", "timeoutSeconds": 90, "oracleRole": "action-result", "dependsOnStepId": "save" },
        { "id": "saved-file", "type": "assert_file", "path": "editor/qed/temp/objects.qsc", "pattern": "112255472", "oracleRole": "action-result", "dependsOnStepId": "save" },
        { "id": "close-before-reopen", "type": "close_editor", "force": true },
        { "id": "reopen", "type": "launch_editor", "level": 12 },
        { "id": "reopen-window", "type": "wait_for_window", "timeoutSeconds": 45 },
        { "id": "reopen-load", "type": "wait", "seconds": 12 },
        { "id": "reopen-file", "type": "assert_file", "path": "editor/qed/temp/objects.qsc", "pattern": "112255472", "oracleRole": "action-result", "dependsOnStepId": "reopen" },
        { "id": "reopened", "type": "screenshot", "name": "reopened-transform" },
        { "id": "open-reset-pause", "type": "key", "key": "ESC" },
        { "id": "reset", "type": "click", "x": 1188, "y": 922 },
        { "id": "reset-settle", "type": "wait", "seconds": 5 },
        { "id": "close-final-reset-pause", "type": "key", "key": "ESC" },
        { "id": "close", "type": "close_editor", "force": true }
      ]
    },
    {
      "name": "level12-model-picker-navigate-apply",
      "level": 12,
      "inputScale": 0.8,
